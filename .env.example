FLORASCOPE_WEB_PORT=8080
FLORASCOPE_API_PORT=8000
FLORASCOPE_ANALYSIS_RESOLUTION_M=20
FLORASCOPE_MAX_ANALYSIS_CELLS=300000
FLORASCOPE_SCENE_WORKERS=3
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Не меняй, если не знаешь, что делаешь :)
FLORASCOPE_EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
FLORASCOPE_OPEN_METEO_URL=https://archive-api.open-meteo.com/v1/archive
FLORASCOPE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Необязательно: proxy, доступный ИЗ контейнера (127.0.0.1 означает сам контейнер).
FLORASCOPE_HTTP_PROXY=
FLORASCOPE_HTTPS_PROXY=
