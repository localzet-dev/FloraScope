# Текстовые файлы фиксируем по EOL, чтобы Windows не ломал shell-скрипты,
# а PowerShell-файлы нормально открывались/редактировались на Windows
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.csv text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.joblib binary
*.tif binary
*.tiff binary
*.zip binary
